# ==============================================================================
# Environment Configuration Template (NO REAL SECRETS)
# Copy this file to .env or .env.local and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (SERVER-ONLY)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# Server-only API key for Google Gemini Generative Language API.
# Never expose this variable to browser clients or prefix with NEXT_PUBLIC_.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Supported Google Gemini Models:
# - gemini-flash-lite-latest (Default, Recommended): High request quota (1,500 RPD free tier), ~1s latency.
# - gemini-3.5-flash: High reasoning capability.
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain credentials from your Supabase project dashboard under Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Server-only service role key (for privileged server tasks & administrative storage verification)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# ------------------------------------------------------------------------------
# Prisma & PostgreSQL Database Connection
# Connection string to Supabase PostgreSQL (use port 6543 pooler with pgBouncer for serverless)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
